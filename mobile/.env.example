# Copy to .env and fill in. Everything is optional — with nothing set the app is
# fully local with no accounts, analytics, or crash reporting.

# Crash reporting (sentry.io → project → Client Keys)
EXPO_PUBLIC_SENTRY_DSN=

# Product analytics (posthog.com → project settings)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Accounts + cloud backup (supabase.com → project settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Deployed Go sync service, e.g. https://logbook-sync.fly.dev
EXPO_PUBLIC_SYNC_URL=
